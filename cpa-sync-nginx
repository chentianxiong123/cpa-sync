#!/usr/bin/env bash
# cpa-sync 自带 nginx：把 web/nginx.conf 安装到系统 nginx 并 reload。
# 用法: cpa-sync-nginx [install|remove]
# install —— 渲染 config/gateway.yaml（上游 1~N 可配）→ /etc/nginx/conf.d/cpa-sync.conf → reload
# remove  —— 卸载配置 → reload
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
DEST=/etc/nginx/conf.d/cpa-sync.conf

case "${1:-install}" in
  install)
    PY="$ROOT/.venv/bin/python"
    [ -x "$PY" ] || { echo "✗ 缺 .venv：python3 -m venv .venv && .venv/bin/pip install PyYAML" >&2; exit 1; }
    "$PY" "$ROOT/scripts/render_gateway.py" --output /tmp/cpa-nginx.conf
    sudo cp /tmp/cpa-nginx.conf "$DEST"
    # 精简：同步低频场景 1 个 worker 够（nginx 默认 auto=CPU 核数，12 核→12 进程）
    if ! grep -qE '^[[:space:]]*worker_processes[[:space:]]+1;' /etc/nginx/nginx.conf; then
      sudo sed -i -E 's/^[[:space:]]*worker_processes[[:space:]]+.*;/worker_processes 1;/' /etc/nginx/nginx.conf
      echo "  · worker_processes → 1（精简，1 个 worker）"
    fi
    sudo nginx -t
    sudo nginx -s reload
    echo "✓ nginx 网关已安装并重载（上游见 config/gateway.yaml）"
    ;;
  remove)
    sudo rm -f "$DEST"
    sudo nginx -s reload
    echo "✓ 已移除 cpa-sync.conf"
    ;;
  *)
    echo "用法: $0 [install|remove]"; exit 1;;
esac
