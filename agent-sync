#!/usr/bin/env python3
"""agent-sync —— 目标机本地同步 CPA 配置到本机 agent 应用。

在**目标机**上运行（无 SSH、无网络拉取）：
  1. 读本机 config/cpa-config.yaml（只需 base_url + api_key + 统一常量）
  2. 连 CPA，动态扫 /v1/models
  3. 对"本机启用的 agent"（config.targets）渲染 + 备份 + 原子写本机文件

用法（在目标机上）:
  python3 agent-sync.py check     # 干跑，看会改什么
  python3 agent-sync.py apply     # 真正同步
  python3 agent-sync.py list      # 本机各 agent 当前状态
  python3 agent-sync.py doctor    # 诊断连接

发行：把整个 agent-sync/ 目录拷到目标机，填 config/cpa-config.yaml，
跑 python3 agent-sync.py apply。
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

from adapters import available_names, get_adapter  # noqa: E402
from core.config import SyncConfig, build_provider_ir  # noqa: E402
from core.cpa_client import CPAClient, CPAError  # noqa: E402

CONFIG_PATH = os.environ.get("CPA_SYNC_CONFIG", str(ROOT / "config" / "cpa-config.yaml"))


def load_config(args) -> SyncConfig:
    return SyncConfig.load(args.config)


def make_client(cfg: SyncConfig) -> CPAClient:
    return CPAClient(cfg.cpa.base_url, cfg.cpa.api_key)


def pick_adapters(cfg: SyncConfig, names: list[str]) -> list[str]:
    """本机要处理的 agent（按 config.targets + 命令行过滤）。"""
    all_n = available_names()
    if names:
        for n in names:
            if n not in all_n:
                raise SystemExit(f"未知 agent: {n}（可用: {all_n}）")
        return names
    if cfg.targets:
        return [n for n in cfg.targets if n in all_n]
    return all_n


def _make_adapter(name: str, cfg: SyncConfig):
    """目标机本地实例化：omp/dsh 用本机模式（host=None，path 本机默认）。
    其它 adapter（pi/opencode/claude/codex）本机本来就用本地文件。"""
    if name == "omp":
        from adapters.omp import OmpAdapter
        return OmpAdapter(cfg, host=None)
    if name == "dsh":
        from adapters.dsh import DshAdapter
        return DshAdapter(cfg, host=None)
    return get_adapter(name, config=cfg)


def cmd_list(args) -> int:
    cfg = load_config(args)
    client = make_client(cfg)
    try:
        cpa_models = client.list_models()
    except CPAError as e:
        print(f"✗ 无法连接 CPA: {e}", file=sys.stderr)
        return 1
    target_ir = build_provider_ir(cfg, cpa_models)
    print(f"CPA: {cfg.cpa.base_url}  目标模型: {', '.join(target_ir.model_ids())}")
    for name in pick_adapters(cfg, args.targets):
        ad = _make_adapter(name, cfg)
        try:
            cur = ad.load_current()
        except Exception as e:  # noqa: BLE001
            print(f"  {name:14s} ⚠ {e}")
            continue
        if cur is None:
            print(f"  {name:14s} (未配置)")
        else:
            print(f"  {name:14s} {cur.base_url}  models={', '.join(cur.model_ids())}")
    return 0


def cmd_check(args) -> int:
    cfg = load_config(args)
    client = make_client(cfg)
    try:
        cpa_models = client.list_models()
    except CPAError as e:
        print(f"✗ 无法连接 CPA: {e}", file=sys.stderr)
        return 1
    target_ir = build_provider_ir(cfg, cpa_models)
    print(f"目标 CPA: {target_ir.base_url}  key={'****'}  模型={len(target_ir.models)}")
    for name in pick_adapters(cfg, args.targets):
        ad = _make_adapter(name, cfg)
        try:
            tgt = ad.merge_with_current(target_ir)
            diffs = ad.check(tgt)
        except Exception as e:  # noqa: BLE001
            print(f"  [{name}] ⚠ 读取失败: {e}")
            continue
        if diffs:
            print(f"  [{name}] 需要同步:")
            for d in diffs:
                print(d)
        else:
            print(f"  [{name}] ✓ 已是最新")
    return 0


def cmd_apply(args) -> int:
    cfg = load_config(args)
    client = make_client(cfg)
    try:
        cpa_models = client.list_models()
    except CPAError as e:
        print(f"✗ 无法连接 CPA: {e}", file=sys.stderr)
        return 1
    target_ir = build_provider_ir(cfg, cpa_models)
    ok = 0
    for name in pick_adapters(cfg, args.targets):
        ad = _make_adapter(name, cfg)
        try:
            cur = ad.load_current()
            tgt = ad.merge_with_current(target_ir)
            diffs = ad.diff(cur, tgt)
        except Exception as e:  # noqa: BLE001
            print(f"  [{name}] ⚠ 读取失败: {e}")
            continue
        if not diffs:
            print(f"  [{name}] ✓ 已是最新，跳过")
            ok += 1
            continue
        print(f"  [{name}] 同步:")
        for d in diffs:
            print(d)
        if not args.yes:
            ans = input("  确认写入? [y/N] ").strip().lower()
            if ans != "y":
                print(f"  [{name}] 跳过")
                continue
        try:
            rendered = ad.render(tgt)
            ad.write(rendered, backup=args.backup)
            print(f"  [{name}] ✓ 已写入")
            ok += 1
        except Exception as e:  # noqa: BLE001
            print(f"  [{name}] ✗ 写入失败: {e}", file=sys.stderr)
    print(f"完成: {ok} 个")
    return 0


def cmd_doctor(args) -> int:
    cfg = load_config(args)
    client = make_client(cfg)
    print("== CPA 连接检查 ==")
    try:
        models = client.list_models()
        print(f"✓ CPA 可达: {cfg.cpa.base_url}  模型 {len(models)} 个")
    except CPAError as e:
        print(f"✗ CPA 连接失败: {e}")
        return 1
    print("== 本机 agent 检查 ==")
    for name in pick_adapters(cfg, args.targets):
        ad = _make_adapter(name, cfg)
        try:
            cur = ad.load_current()
            status = f"{cur.base_url}  models={len(cur.models)}" if cur else "(未配置)"
            print(f"  {name:14s} ✓ {status}")
        except Exception as e:  # noqa: BLE001
            print(f"  {name:14s} ✗ {e}")
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="agent-sync", description="本机同步 CPA 配置到本机 agent")
    p.add_argument("--config", default=CONFIG_PATH, help="本机配置文件路径")
    p.add_argument("--version", action="version", version="agent-sync 1.0.0")
    sub = p.add_subparsers(dest="cmd")
    for name, fn, help_ in (
        ("list", cmd_list, "本机各 agent 当前状态"),
        ("check", cmd_check, "干跑：只对比不改"),
        ("apply", cmd_apply, "真正同步（自动备份）"),
        ("doctor", cmd_doctor, "诊断连接/配置"),
    ):
        s = sub.add_parser(name, help=help_)
        s.add_argument("targets", nargs="*", help="agent 名，空=本机全部")
        if name == "apply":
            s.add_argument("-y", "--yes", action="store_true", help="跳过确认")
            s.add_argument("--backup", action="store_true", default=False, help="写前自动备份")
        s.set_defaults(fn=fn)
    args = p.parse_args(argv)
    if not getattr(args, "fn", None):
        p.print_help()
        return 1
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
